<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- DocumentsProvider.attachInfo mandates exported + MANAGE_DOCUMENTS +
             grantUriPermissions; the test (same uid) bypasses the permission check. -->
        <provider
            android:name="com.lazygeniouz.dfc.observer.TestDocumentsProvider"
            android:authorities="com.lazygeniouz.dfc.test.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS" />
    </application>
</manifest>